# Copier ce fichier en .env.local et renseigner les deux valeurs (affichées par `pnpm db:status`).
# Ce sont des valeurs PUBLIQUES. Ne jamais mettre ici la clé secrète / service_role.
# Sans ces valeurs, l'application affiche le jeu de démonstration fictif.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
